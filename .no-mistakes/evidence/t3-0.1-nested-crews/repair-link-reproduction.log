t3_thread_launch {"name":"t3_thread_launch","description":"Create one new top-level thread, bound to its workspace before the agent starts. Task in `message`. Omit `projectId`, model and modes to inherit yours (outside a thread, pass `projectId` or `scratch`); modes cannot exceed yours. After an error or lost reply, retry with the same `clientRequestId`. Follow it with `t3_thread_read` or `t3_thread_wait`. Mention it with its `link`.","inputSchema":{"type":"object","properties":{"environmentId":{"type":"string"},"projectId":{"type":"string"},"scratch":{"type":"boolean","description":"No project: a new Scratch folder. Not with `projectId` or `workspaceStrategy`."},"title":{"type":"string"},"modelSelection":{"type":"object","properties":{"provider":{},"instanceId":{},"model":{},"options":{}},"required":["model"]},"runtimeMode":{"type":"string","enum":["approval-required","auto-accept-edits","auto","full-access"]},"interactionMode":{"type":"string","enum":["default","plan"]},"workspaceStrategy":{"type":"object","properties":{"type":{"type":"string","enum":["root","existing_worktree","worktree"]},"branch":{"type":"string"},"worktreePath":{"type":"string"},"baseRef":{"type":"string"},"startFromOrigin":{"type":"boolean"}},"required":["type"],"description":"'worktree': new checkout from `baseRef`. Honor a requested base. Otherwise, independent work uses the default branch as `remote/branch` (e.g. `origin/main`) with `startFromOrigin: true`; with no remote, use the local default branch. Required unpublished commits and dependent or stacked work use their local base with `startFromOrigin: false`. 'existing_worktree': bind `worktreePath`, a project worktree. 'root': project checkout, the default, not your worktree. Uncommitted edits are not copied."},"message":{"type":"string","maxLength":120000,"description":"First prompt. Omit it and `attachments` for idle."},"attachments":{"type":"array","items":{"type":"object","properties":{"type":{"type":"string","enum":["image","file"]},"id":{"type":"string"},"name":{"type":"string"},"mimeType":{"type":"string"},"sizeBytes":{"anyOf":[{"type":"integer","minimum":0,"maximum":10485760},{"type":"integer","minimum":1,"maximum":52428800}]},"source":{"type":"object","properties":{"_tag":{"type":"string","enum":["pasted-text"]}},"required":["_tag"]}},"required":["type","id","name","mimeType","sizeBytes"]},"maxItems":8},"clientRequestId":{"type":"string"},"delegatedFrom":{"type":"object","properties":{"environmentId":{"type":"string"},"threadId":{"type":"string"},"title":{"type":"string"}},"required":["environmentId","threadId","title"]}},"required":["title"]},"outputSchema":{"type":"object","properties":{"threadId":{"type":"string"},"link":{"anyOf":[{"type":"string"},{"type":"null"}]},"projectId":{"type":"string"},"modelSelection":{"type":"object","properties":{"provider":{"anyOf":[{},{"type":"null"}]},"instanceId":{"anyOf":[{},{"type":"null"}]},"model":{},"options":{"anyOf":[{},{"type":"null"}]}},"required":["model"],"additionalProperties":true},"runId":{"anyOf":[{"type":"string"},{"type":"null"}]},"status":{"anyOf":[{"type":"string","enum":["preparing","queued","starting","running","waiting","completed","interrupted","failed","cancelled","rolled_back"]},{"type":"null"}]}},"required":["threadId","projectId","modelSelection","runId","status"],"additionalProperties":true},"annotations":{"readOnlyHint":false,"destructiveHint":true,"idempotentHint":false,"openWorldHint":true}}
